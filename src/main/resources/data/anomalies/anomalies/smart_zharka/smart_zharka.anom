state idle --> "idle.json";
state warmup --> "warmup.json";
state burst --> "burst.json";
state cooldown --> "cooldown.json";

recipe cook_pork --> "recipes/cook_pork.json";
recipe roast_beef --> "recipes/roast_beef.json";
recipe make_glass --> "recipes/make_glass.json";

initial = idle;

state idle {
    when player.in_zone(0) -> warmup;
}

state warmup {
    when timer(20) -> burst;
}

state burst {
    recipe {
        cook_pork;
        roast_beef;
        make_glass;
    }
    when timer(50) -> cooldown;
}

state cooldown {
    when timer(60) -> idle;
}